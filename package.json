{
  "name": "berth-market",
  "version": "0.1.0",
  "private": true,
  "description": "Berth Market — agent spend/earn layer. Lists HTTP, MCP, and desktop SKUs; prices them; moves USDC on Base / Base Sepolia via x402.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "earn-loop": "tsx src/scripts/earn-loop.ts",
    "sepolia-loop": "tsx src/scripts/sepolia-loop.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "hono": "^4.9.6",
    "viem": "^2.55.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.2",
    "eslint": "^9.33.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
