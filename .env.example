# Local / test adapters need no secrets.
PORT=8787

# Protocol treasury that receives the 10% market cut (0x address).
# Leave empty to use the in-memory protocol wallet created at boot.
PROTOCOL_TREASURY_ADDRESS=

# Optional HTTP EligibilityClient — Berthos doctor. Fail-closed for desktop kinds.
BERTHOS_URL=http://127.0.0.1:8788
BERTHOS_DOCTOR_PATH=/doctor

# CDP adapter is a documented TODO. Do not set these for tests.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
