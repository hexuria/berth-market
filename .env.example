# Local / test adapters need no secrets.
PORT=8787

# Protocol treasury that receives the 10% market cut (0x address).
# Leave empty to use the in-memory protocol wallet created at boot.
PROTOCOL_TREASURY_ADDRESS=

# Berthos HTTP — eligibility + leases. Leave unset in CI (Memory clients, no live node).
# BERTHOS_URL=http://127.0.0.1:7432
# BERTHOS_ELIGIBILITY_PATH=/v1/eligibility
# Bearer with `lease` capability (POST /v1/pair on the node). Required to create/end guests.
# BERTHOS_LEASE_TOKEN=
# Optional one-shot pairing if you have the code from `berth node up` / GET /v1/pairing.
# BERTHOS_PAIR_CODE=
# ATTESTATION_MAX_AGE_MS=86400000

# Live x402 facilitator. Leave unset so tests use TestFacilitator (no network).
# Public testnet facilitator (no API key): Base Sepolia only. Do not point this at mainnet.
# FACILITATOR_URL=https://x402.org/facilitator

# Browser origins allowed to call this process (comma list).
# Default is Vite loopback :5173 and :5174 (127.0.0.1 and localhost) — not *.
# Set this to the deployed UI origin in production. Opt into * only if you mean it.
# CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# Catalog default for new listings that omit price.network. Stored as CAIP-2.
# Existing listings that already set eip155:8453 are not rewritten.
# NETWORK=eip155:84532
# Mainnet catalog default: NETWORK=eip155:8453

# Opt-in Base Sepolia loop (`npm run sepolia-loop`). Testnet only — never mainnet.
# Never commit these. The process never logs the private key.
# STAGING_PAYER_PRIVATE_KEY=0x
# X402_PAYER_PRIVATE_KEY=          # alias of STAGING_PAYER_PRIVATE_KEY
# STAGING_PAY_TO=0x                # seller / receiver EOA on Base Sepolia

# CDP adapter is env-flagged. Do not set WALLET_ADAPTER=cdp in CI.
# Live adapter is constructed only when WALLET_ADAPTER=cdp AND all three keys are set.
# Missing keys → boot throws (does not construct CdpWalletAdapter).
# Live CDP network is base-sepolia unless NETWORK or CDP_NETWORK is explicitly base / eip155:8453.
# No mainnet default. sepolia-loop forces WALLET_ADAPTER=memory.
# CDP_NETWORK=base-sepolia
# WALLET_ADAPTER=memory
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
